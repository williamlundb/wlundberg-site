---
import SocialLinks from "./SocialLinks.astro";
import { siteConfig, navLinks } from "../config";
---

<footer class="relative bg-gray-50 border-t border-gray-200">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div class="flex flex-col gap-4 text-gray-600">
        <h3 class="text-2xl font-bold text-gray-800">{siteConfig.name}</h3>
        <p class="text-base">{siteConfig.title} · {siteConfig.company}</p>
        <SocialLinks />
      </div>

      <div class="flex flex-col md:items-end gap-4">
        <nav class="flex flex-wrap gap-x-8 gap-y-2">
          {
            navLinks.map((link) => (
              <a href={link.href} class="text-sm text-gray-600 hover:text-gray-800 transition-colors">
                {link.label}
              </a>
            ))
          }
        </nav>
        <p class="text-sm text-gray-500">
          © {new Date().getFullYear()} {siteConfig.name}
        </p>
      </div>
    </div>
  </div>
</footer>
