---
import SectionHeading from "./SectionHeading.astro";
import { siteConfig } from "../config";
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
    <div class="lg:col-span-4">
      <SectionHeading title="About Me" as="h1" />
    </div>

    <div class="lg:col-span-8 space-y-6">
      {
        siteConfig.aboutMe.map((paragraph) => (
          <p class="text-lg sm:text-xl leading-relaxed text-gray-400">{paragraph}</p>
        ))
      }
    </div>
  </div>
</section>

<section id="skills" class="p-8 sm:p-12 md:p-16 lg:p-24 pt-0 sm:pt-0 md:pt-0 lg:pt-0">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
    <div class="lg:col-span-4">
      <SectionHeading title="Skills" />
    </div>
    <div class="lg:col-span-8 flex flex-wrap gap-3">
      {
        siteConfig.skills.map((skill) => (
          <span class="px-3 sm:px-4 py-1.5 sm:py-2 bg-gray-800 text-gray-100 rounded-full text-sm sm:text-base font-medium hover:bg-gray-700 transition-colors duration-200">
            {skill}
          </span>
        ))
      }
    </div>
  </div>
</section>

<section id="interests" class="p-8 sm:p-12 md:p-16 lg:p-24 pt-0 sm:pt-0 md:pt-0 lg:pt-0">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
    <div class="lg:col-span-4">
      <SectionHeading title="Interests" />
    </div>
    <div class="lg:col-span-8 grid sm:grid-cols-2 gap-6">
      {
        siteConfig.interests.map((item) => (
          <div class="bg-gray-900 rounded-lg shadow-sm border border-gray-800 p-5 sm:p-6">
            <h3 class="text-lg font-semibold text-gray-100">{item.title}</h3>
            <p class="mt-2 text-gray-400">{item.description}</p>
            {"link" in item && (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group mt-4 inline-block font-semibold text-[var(--accent-color)] hover:underline"
              >
                {item.linkLabel} <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
